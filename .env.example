APP_NAME="Agentic Banking Assistant"
ENVIRONMENT=local
API_KEY=dev-secret

# LLM providers: mock, gemini, groq, openai
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional real RAGAS evaluation.
# RAGAS_JUDGE_PROVIDER=groq uses GROQ_API_KEY and Groq OpenAI-compatible endpoint.
# Set OPENAI_API_KEY too if you want RAGAS answer_relevancy embeddings.
RAGAS_JUDGE_PROVIDER=groq
RAGAS_APP_PROVIDER=groq
RAGAS_OPENAI_JUDGE_MODEL=gpt-4o-mini
RAGAS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

VECTOR_BACKEND=chroma
CHROMA_DIR=.chroma
TOP_K=4
MAX_CONTEXT_CHARS=4500
HYBRID_VECTOR_WEIGHT=0.65
HYBRID_BM25_WEIGHT=0.35
RERANK_TOP_N=8
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.94
HITL_ENABLED=true

MEMORY_PERSISTENCE_ENABLED=true
MEMORY_PATH=data/runtime/conversation_memory.json
MEMORY_PERSIST_REQUIRES_CONSENT=true

OTEL_ENABLED=false
OTEL_SERVICE_NAME=agentic-banking-assistant
OTEL_EXPORTER_OTLP_ENDPOINT=
